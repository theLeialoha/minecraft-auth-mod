{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",
  "name": "${mod_display_name}",
  "description": "Example mod description",
  "authors": [
    "Example Author"
  ],
  "contact": {
    "homepage": "https://www.curseforge.com/minecraft/mc-mods/example-mod",
    "issues": "https://github.com/example/example_mod/issues",
    "sources": "https://github.com/example/example_mod",
    "email": "example@example.com"
  },
  "license": "GPL",
  "icon": "icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.example.example_mod.FabricExampleMod"
    ],
    "client": [
      "com.example.example_mod.FabricExampleMod"
    ]
  },
  "mixins": [
    "${mod_id}.mixins.json"
  ],
  "depends": {
    "fabricloader": "${fabric_loader_dependency}",
    "minecraft": "${minecraft_dependency}",
    "java": ">=${java_version}"
  },
  "suggests": {
    "modmenu": "*",
    "cloth-config2": ">=${cloth_config_version}"
  },
  "accessWidener": "${mod_id}.accesswidener"
}
